# ===== Frontend (Vite) environment variables =====
# Copy this file to .env and fill in your values. Vite exposes only the
# variables prefixed with VITE_ to the browser.

# API base URL for the Express backend (used by src/services/api.js)
# Vercel (frontend + API on the same deployment): VITE_API_URL=/api
VITE_API_URL=http://localhost:5000/api

# Official TikTok account URL shown in the footer social icons
VITE_TIKTOK_URL=https://www.tiktok.com/@borjalarab97

# Official Instagram account URL
VITE_INSTAGRAM_URL=https://www.instagram.com/borjalarab97/

# Official Facebook account URL
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61594331250876&sk=directory_intro

# Office WhatsApp number in international format WITHOUT "+" or dashes
# (used to build https://wa.me/<number> links)
VITE_WHATSAPP_NUMBER=966502331197